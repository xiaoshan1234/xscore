# xscore integration-test configuration example.
#
# Copy this file to test.config in the same directory. The integration tests
# read that file directly; credentials are not read from caller environment
# variables.
#
# Format:
#   - UTF-8 text, one `key=value` per line
#   - blank lines and lines starting with `#` are ignored
#   - keys and values are trimmed; the first `=` splits the line
#   - no inline comments or shell quoting are processed
#   - a password may contain `=` or `#`
#   - required keys are `ssh_host` and `ssh_password`
#   - optional key is `ssh_port` (default 22)

# ---------------------------------------------------------------------------
# SSH shell (crates/emulator/tests/ssh_shell.rs)
# tmux over SSH (crates/emulator/tests/tmux_ssh.rs)
# tmux frontend askpass path (crates/emulator-frontend/tests/tmux_ssh.rs)
# ---------------------------------------------------------------------------

# The local `ssh` command must be able to reach this destination.
# Use "user@host".
ssh_host=user@host

# The remote account password used by the test.
ssh_password=replace-with-password

# Optional. Defaults to 22 when omitted.
ssh_port=22

# ---------------------------------------------------------------------------
# Host requirements
# ---------------------------------------------------------------------------
#
# Local machine:
#   - cargo and rustc
#   - OpenSSH client 8.4+ with SSH_ASKPASS_REQUIRE support
#   - Network/DNS access to the configured ssh_host
#
# Remote machine:
#   - SSH access for the configured user
#   - tmux installed and available in PATH
#   - permission to run new-session, split-window, kill-pane and kill-session
#
# The Python integration runner builds xs and passes its path to tests through
# XSCORE_TEST_ASKPASS. The tests pass the configured password to that subprocess
# as part of the application's internal askpass contract; no SSH environment
# configuration is required from the caller.

# ---------------------------------------------------------------------------
# Local Domain test (crates/emulator/tests/local_domain.rs)
# ---------------------------------------------------------------------------
#
# No environment variables are required. The host must provide:
#   - cmd.exe on Windows
#   - sh on Unix-like systems
#
# Commands:
#   cargo test -p emulator -p emulator-frontend
#   python scripts/run_integration_tests.py
